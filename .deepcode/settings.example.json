    "//_paper-radar-20260827": "paper to capability pipeline",
    "paper-radar": true,
    "//_self-harness-20260827": "Self-Harness paper arXiv:2606.09498",
    "self-harness": true,
    "//_local-model-20260827": "local small model scenarios guide",
    "local-model-scenarios": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "modes": {
      "acceptEdits": {
        "description": "Auto-accept edits, ask for dangerous operations"
      },
      "auto": {
        "description": "Auto-accept everything"
      },
      "bypassPermissions": {
        "description": "Bypass all permission checks"
      },
      "manual": {
        "description": "Ask before every operation"
      },
      "dontAsk": {
        "description": "Silently allow all (same as auto)"
      },
      "plan": {
        "description": "Plan mode: analyze and propose, never execute"
      }
    },
    "allow": [
      "read-out-cwd",
      "write-in-cwd",
      "mcp",
      "read-in-cwd",
      "network",
      "write-out-cwd",
      "delete-in-cwd",
      "query-git-log",
      "mutate-git-log",
      "delete-out-cwd",
      "write-in-cwd"
    ],
    "deny": [],
    "ask": []
  },
  "strictMcpConfig": false,
  "//_harness_enhancements": "P0-P2 improvements added 2026-08-27 based on Western harness best practices (SandBase, awesome-harness-engineering)",
  "sandbox": {
    "defaultBackend": "local",
    "backends": {
      "local": {
        "enabled": true,
        "type": "local"
      },
      "docker": {
        "enabled": false,
        "type": "docker",
        "image": "node:22-slim",
        "resources": {
          "memory": "1g",
          "cpu": 1
        }
      },
      "e2b": {
        "enabled": true,
        "type": "e2b",
        "apiKey": "${E2B_API_KEY}"
      }
    }
  },
  "credentials": {
    "vault": {
      "enabled": true,
      "backend": "local",
      "encryption": {
        "algorithm": "aes-256-gcm",
        "keyDerivation": "pbkdf2",
        "iterations": 600000
      },
      "autoLock": {
        "timeout": 900,
        "onIdle": true
      }
    }
  },
  "approval": {
    "highRisk": {
      "required": true,
      "approvers": [
        "@Zongwei9888"
      ],
      "label": "security",
      "autoAssign": true
    },
    "mediumRisk": {
      "required": true,
      "approvers": [],
      "autoAssign": false
    }
  },
  "session": {
    "stream": {
      "enabled": true,
      "backend": "sqlite",
      "retention": "30d",
      "resumable": true
    }
  },
  "telemetry": {
    "enabled": false,
    "exporter": "deepcode-telemetry",
    "endpoint": "http://127.0.0.1:4318",
    "serviceName": "deepcode-harness",
    "sampling": {
      "traces": 1,
      "metrics": 1
    },
    "instrumentation": {
      "http": true,
      "filesystem": true
    }
  },
  "pluginUrls": [],
