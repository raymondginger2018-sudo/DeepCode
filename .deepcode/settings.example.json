    "browser-automation": true,
    "browser-extension-reverse": true,
    "diagram-generator": true,
    "docs-generator": true,
    "code-audit": true,
    "windows-ad": true,
    "//reverse-skill-disabled": "低频场景（默认禁用，按需改为 true 启用）",
    "radio-sdr": true,
    "hardware-security": true,
    "ot-ics": true,
    "cloud-k8s": true,
    "email-security": true,
