{
  "thinkingEnabled": true,
  "reasoningEffort": "low",
  "model": "DeepSeek-V4-Flash",
  "autoCompactWindow": 128000,
  "env": {
    "FORK_SUBAGENT": "true",
    "FORCE_SANDBOX": "false",
    "BASE_URL": "https://api.scnet.cn/api/llm/v1",
    "API_KEY": "sk-tp-NDIyLTEyMjE4NjUyNDUzLTE3ODczMTcxMjM3MzI=",
    "DEEPSEEK_API_KEY": "sk-tp-NDIyLTEyMjE4NjUyNDUzLTE3ODczMTcxMjM3MzI="
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "type": "command",
        "command": "python3 F:/DEEPCODE/scripts/pipelines/pipeline_sandbox_validator.py {file_path}",
        "timeout": 15
      },
      {
        "matcher": "Edit",
        "type": "command",
        "command": "python3 F:/DEEPCODE/scripts/pipelines/pipeline_sandbox_validator.py {file_path}",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "type": "command",
        "command": "echo [hook] PostToolUse: Bash exit={tool_response.exit_code}",
        "timeout": 10
      },
      {
        "name": "auto-deposit-buffer",
        "matcher": "^mcp__(playwright|ghidra-mcp|deepcode-decompiler)__",
        "type": "command",
        "command": "python3 F:/DEEPCODE/scripts/auto_deposit_hook.py",
        "timeout": 10
      }
    ],
    "//_cerebellum_migrated_20260826": "SessionStart/PreCompact → .deepcode/hooks.json; PostTask/SessionEnd/OnError → 引擎不支持此事件, 经验提炼已合并到 PreCompact",
    "SessionStart": [
      {
        "type": "command",
        "command": "echo [hook] Session started at {timestamp}"
      },
      {
        "type": "command",
        "command": "cmd /c start /b python3 F:/DEEPCODE/scripts/update_pr_doc.py",
        "timeout": 5
      }
    ],
    "Route": [],
    "OnError": [],
    "PreTask": [],
    "PostTask": [],
    "Stop": [],
    "SessionEnd": [
      {
        "name": "auto-deposit-flush",
        "type": "command",
        "command": "cmd /c start /b python3 F:/DEEPCODE/scripts/auto_deposit_hook.py --flush",
        "timeout": 5
      }
    ],
    "PreCompact": [
      {
        "name": "token-saver-prewarm",
        "type": "command",
        "command": "python3 F:/DEEPCODE/core/mcp_servers/token_saver_mcp_server.py --cli prewarm || echo [token-saver] prewarm 跳过 (Ollama 不可用)",
        "timeout": 120
      }
    ]
  },
  "enabledSkills": {
    "//note": "仅列出实际存在于 .deepcode/skills/ 的 Skills",
    "model-provider-connect": true,
    "deepcode-agent": true,
    "deepcode-auth": true,
    "deepcode-chrome": true,
    "deepcode-hooks": true,
    "deepcode-project-rules": true,
    "deepcode-reverse-engineering": true,
    "deepcode-sandbox": true,
    "deepcode-starlark": true,
    "deepcode-streaming": true,
    "deepcode-telemetry": true,
    "deepcode-knowledge": true,
    "deepcode-workflow": true,
    "ensemble": true,
    "harmony-next": true,
    "planning-with-files": true,
    "schematic": true,
    "//reverse-skill-note": "逆向 skill 全家桶（zhaoxuya520/reverse-skill 适配 2026-08-01）：核心逆向启用、低频场景禁用",
    "dsl-vm-reverse": true,
    "ida-reverse": true,
    "js-reverse": true,
    "malware-analysis": true,
    "apk-reverse": true,
    "ghidra-reverse": true,
